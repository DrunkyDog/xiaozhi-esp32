CONFIG_BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_06=y
CONFIG_LANGUAGE_TH_TH=y
CONFIG_OTA_URL="https://alice.project-alice.uk/xiaozhi/ota/"
CONFIG_USE_WECHAT_MESSAGE_STYLE=n
CONFIG_USE_DEVICE_AEC=y

# Wake word: WakeNet9 "computer" (Star Trek style), AFE + AEC
# NOTE: afe_audio_engine.cc picks MultiNet over WakeNet whenever ANY multinet
# model is flashed, so both MN models must stay off for WakeNet to be used.
CONFIG_USE_AFE_WAKE_WORD=y
CONFIG_SR_WN_WN9_COMPUTER_TTS=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n
CONFIG_SR_MN_EN_NONE=y
CONFIG_SR_MN_CN_NONE=y

# LVGL widgets used by the CSI radar app (main/apps/radar_app.cc):
# lv_chart_* for the vitals plot, lv_tileview_* for the 4-page swipe UI.
# sdkconfig.defaults turns both off to save flash, so they must be
# re-enabled here or radar_app.cc fails to compile with
# "'lv_chart_create' was not declared in this scope".
CONFIG_LV_USE_CHART=y
CONFIG_LV_USE_TILEVIEW=y
