+static bool IsSha256Hex(const char* s) {
+    if (s == nullptr || strlen(s) != 64) return false;
+    for (int i = 0; i < 64; i++) {
+        if (!isxdigit((unsigned char)s[i])) return false;
+    }
+    return true;
+}
